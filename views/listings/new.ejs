<% layout("/layouts/boilerplate")%>

    <body>
        <div class="row mt-3 row-new">
            <div class="col-8 offset-2">
                <h3>Add new home</h3>
                <form action="/listing/new" method="post" class="row needs-validation" novalidate
                    enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" name="listing[title]" placeholder="Add a catchy title" class="form-control"
                            required id="title">
                        <div class="valid-feedback">Title looks good!</div>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea name="listing[description]" placeholder="Add description" class="form-control"
                            required id="description"></textarea>
                        <div class="invalid-feedback">Please enter a short description</div>
                    </div>
                    <div class="mb-3">
                        <label for="category" class="form-label">Category</label>
                        <textarea name="listing[category]" placeholder="Add category" class="form-control"
                            required id="category"></textarea>
                        <div class="invalid-feedback">Please enter category</div>
                    </div>
                    <div class="mb-3">
                        <label for="image" class="form-label">Upload Image</label>
                        <input type="file" name="listing[image]" class="form-control" required id="image.url">
                        <div class="invalid-feedback">Enter valid image URL</div>
                    </div>
                    <div class="row">
                        <div class="mb-3 col-md-4">
                            <label for="price" class="form-label">Price</label>
                            <input name="listing[price]" placeholder="1200" class="form-control" required id="price">
                            <div class="invalid-feedback">Please enter price</div>
                        </div>
                        <div class="mb-3 col-md-8">
                            <label for="country" class="form-label">Country</label>
                            <input type="text" name="listing[country]" placeholder="India" class="form-control" required
                                id="country">
                            <div class="invalid-feedback">Country name should be valid</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" name="listing[location]" placeholder="jaipur" class="form-control" required
                            id="location">
                        <div class="invalid-feedback">Please enter valid location</div>
                    </div>

                    <button class="btn btn-dark add-btn mt-3 mx-auto">Add</button>
                    <br><br>
                </form>
            </div>
        </div>
    </body>